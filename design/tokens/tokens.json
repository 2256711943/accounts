{
  "$schema": "https://design-tokens.org/schema.json",
  "$meta": {
    "name": "SnapLedger Design Tokens",
    "version": "1.1.0",
    "updatedAt": "2026-09-22",
    "source": "Figma Variables (01 Foundations)",
    "note": "本文件是设计稿与代码样式的单一来源。改这里 -> 跑 npm run gen:scss -> 生成 src/styles/tokens.scss（同时产出 SCSS 变量与 CSS 自定义属性两份形态）。代码中禁止出现字面色值。命名约定见 docs/UI_SPEC.md §2.7；第三方组件库 wot-design-uni 的主题映射（--wot-* 变量）在 src/styles/wot-theme.scss 中引用本文件的 SCSS 变量，见 docs/UI_SPEC.md §4.3。"
  },

  "color": {
    "bg": {
      "base":    { "$value": "#FAF9F5", "$type": "color", "$description": "页面底色（暖白）" },
      "surface": { "$value": "#FFFFFF", "$type": "color", "$description": "卡片、列表项" },
      "subtle":  { "$value": "#F2F0E9", "$type": "color", "$description": "次级块、标签底、骨架屏底" },
      "mask":    { "$value": "rgba(44,44,42,0.45)", "$type": "color", "$description": "弹层遮罩" }
    },
    "line": {
      "default": { "$value": "rgba(44,44,42,0.08)", "$type": "color", "$description": "必要分割线，尽量少用" },
      "strong":  { "$value": "rgba(44,44,42,0.16)", "$type": "color", "$description": "输入框边框、需强调的分隔" }
    },
    "text": {
      "primary":   { "$value": "#2C2C2A", "$type": "color", "$description": "主文案、支出金额" },
      "secondary": { "$value": "#6B6A64", "$type": "color", "$description": "辅助说明、时间、分类名" },
      "tertiary":  { "$value": "#9C9A92", "$type": "color", "$description": "占位符、禁用态" },
      "inverse":   { "$value": "#FFFFFF", "$type": "color", "$description": "深底上的文字" }
    },
    "accent": {
      "default": { "$value": "#E8663D", "$type": "color", "$description": "唯一强调色：主按钮、FAB、选中态" },
      "pressed": { "$value": "#C9502C", "$type": "color", "$description": "按压态" },
      "soft":    { "$value": "#FBEDE7", "$type": "color", "$description": "强调色浅底（选中标签）" }
    },
    "semantic": {
      "success": { "$value": "#2F8F7A", "$type": "color", "$description": "收入金额、同步成功" },
      "warning": { "$value": "#D9952B", "$type": "color", "$description": "待同步、识别降级" },
      "danger":  { "$value": "#C4453C", "$type": "color", "$description": "删除、同步失败" },
      "info":    { "$value": "#5B7A8C", "$type": "color", "$description": "中性提示（雾蓝）" }
    },
    "chart": {
      "c1": { "$value": "#E8663D", "$type": "color" },
      "c2": { "$value": "#D9952B", "$type": "color" },
      "c3": { "$value": "#2F8F7A", "$type": "color" },
      "c4": { "$value": "#B4566E", "$type": "color" },
      "c5": { "$value": "#5B7A8C", "$type": "color" }
    }
  },

  "font": {
    "family": {
      "sans": { "$value": "-apple-system, \"PingFang SC\", \"HarmonyOS Sans SC\", \"Noto Sans SC\", \"Microsoft YaHei\", sans-serif", "$type": "fontFamily" }
    },
    "size": {
      "display": { "$value": "34px", "$type": "dimension", "$description": "68rpx 首页本月总支出" },
      "h1":      { "$value": "22px", "$type": "dimension", "$description": "44rpx 页面大标题" },
      "h2":      { "$value": "17px", "$type": "dimension", "$description": "34rpx 区块标题" },
      "body":    { "$value": "15px", "$type": "dimension", "$description": "30rpx 列表主文案" },
      "caption": { "$value": "13px", "$type": "dimension", "$description": "26rpx 辅助说明" },
      "tiny":    { "$value": "11px", "$type": "dimension", "$description": "22rpx 标签、角标" }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium":  { "$value": 500, "$type": "fontWeight", "$description": "只有两档，再粗就廉价" }
    },
    "lineHeight": {
      "display": { "$value": 1.15, "$type": "number" },
      "h1":      { "$value": 1.3,  "$type": "number" },
      "h2":      { "$value": 1.4,  "$type": "number" },
      "body":    { "$value": 1.5,  "$type": "number" },
      "caption": { "$value": 1.4,  "$type": "number" }
    }
  },

  "space": {
    "1": { "$value": "4px",  "$type": "dimension", "$description": "8rpx 图标与文字间隙" },
    "2": { "$value": "8px",  "$type": "dimension", "$description": "16rpx 标签内边距" },
    "3": { "$value": "12px", "$type": "dimension", "$description": "24rpx 卡片内元素间距" },
    "4": { "$value": "16px", "$type": "dimension", "$description": "32rpx 页面左右边距 / 卡片内边距" },
    "5": { "$value": "20px", "$type": "dimension", "$description": "40rpx 区块之间" },
    "6": { "$value": "24px", "$type": "dimension", "$description": "48rpx 大区块分隔" },
    "8": { "$value": "32px", "$type": "dimension", "$description": "64rpx 页面顶部大留白" }
  },

  "radius": {
    "sm":   { "$value": "8px",   "$type": "dimension", "$description": "16rpx 标签、角标" },
    "md":   { "$value": "12px",  "$type": "dimension", "$description": "24rpx 输入框、小卡片" },
    "lg":   { "$value": "16px",  "$type": "dimension", "$description": "32rpx 主卡片、FAB" },
    "xl":   { "$value": "20px",  "$type": "dimension", "$description": "40rpx 底部抽屉顶部" },
    "full": { "$value": "999px", "$type": "dimension", "$description": "药丸按钮、头像" }
  },

  "shadow": {
    "1": { "$value": "0 1px 2px rgba(44,44,42,0.04)",  "$type": "shadow", "$description": "列表卡片" },
    "2": { "$value": "0 4px 16px rgba(44,44,42,0.06)", "$type": "shadow", "$description": "悬浮 FAB、底部抽屉" }
  },

  "motion": {
    "duration": {
      "fast": { "$value": "120ms", "$type": "duration", "$description": "按压反馈、标签切换" },
      "base": { "$value": "200ms", "$type": "duration", "$description": "列表项入场" },
      "slow": { "$value": "320ms", "$type": "duration", "$description": "页面转场、抽屉" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)",    "$type": "cubicBezier", "$description": "通用减速" },
      "spring":   { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier", "$description": "小元素入场" }
    }
  },

  "layout": {
    "designWidth":    { "$value": 375,  "$type": "number", "$description": "Figma 画板宽度（1x）" },
    "rpxRatio":       { "$value": 2,    "$type": "number", "$description": "设计稿 1px = 代码 2rpx" },
    "h5MaxWidth":     { "$value": "480px", "$type": "dimension", "$description": "H5 宽屏内容容器上限" },
    "pagePadding":    { "$value": "16px",  "$type": "dimension", "$description": "页面左右边距 32rpx" },
    "tabBarHeight":   { "$value": "50px",  "$type": "dimension", "$description": "100rpx，另加 --safe-bottom" },
    "navBarHeight":   { "$value": "44px",  "$type": "dimension", "$description": "另加 statusBarHeight" },
    "fabSize":        { "$value": "56px",  "$type": "dimension", "$description": "112rpx" },
    "cellMinHeight":  { "$value": "44px",  "$type": "dimension", "$description": "88rpx" }
  }
}
