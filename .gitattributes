# 统一换行符：仓库内一律 LF，避免 Windows / macOS 协作时的整文件 diff 噪音
* text=auto eol=lf

# 二进制 / 生成物不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# 锁文件在 diff / review 里折叠
package-lock.json -diff linguist-generated=true

# 生成产物标记为自动生成（GitHub 会折叠）
src/styles/tokens.scss linguist-generated=true
design/figma-plugin/code.js linguist-generated=false
