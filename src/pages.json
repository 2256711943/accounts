{





	"easycom": {
		"autoscan": true,
		"custom": {
			"^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue",
			"^Sg(.*)$": "@/components/$1/index.vue"
		}
	},
	"pages": [

		{
			"path": "pages/index/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "一拍记",
				"enablePullDownRefresh": true,
				"backgroundTextStyle": "dark"
			}
		},

		{
			"path": "pages/dev/components",
			"style": {
				"navigationBarTitleText": "组件验收"
			}
		},

		{
			"path": "pages/dev/compress",
			"style": {
				"navigationBarTitleText": "压缩采集"
			}
		},
		{
			"path": "pages/dev/perf",
			"style": {
				"navigationBarTitleText": "性能面板"
			}
		},

		{
			"path": "pages/profile/index",
			"style": {
				"navigationBarTitleText": "我的"
			}
		}
	],

	"subPackages": [
		{
			"root": "pages-capture",
			"pages": [
				{
					"path": "index",
					"style": {
						"navigationStyle": "custom",
						"navigationBarTitleText": "拍照记账"
					}
				}
			]
		},
		{
			"root": "pages-stats",
			"pages": [
				{
					"path": "index",
					"style": {
						"navigationBarTitleText": "统计"
					}
				}
			]
		},
		{
			"root": "pages-detail",
			"pages": [
				{
					"path": "index",
					"style": {
						"navigationBarTitleText": "账单详情"
					}
				}
			]
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "一拍记",



		"navigationBarBackgroundColor": "#FAFAFC",
		"backgroundColor": "#FAFAFC"
	},


	"preloadRule": {
		"pages/index/index": {
			"network": "all",
			"packages": ["pages-stats"]
		}
	}
}
