{
	// easycom：wot-design-uni 的唯一引入方式（AGENTS.md 组件引入红线）。
	// 只有模板里真实出现过的 wd-* 才会进包，这是主包体积预算的前提。
	// Sg 系列为自研原子组件：`<SgButton>` → `src/components/Button/index.vue`。
	// 业务组件（biz/Feedback.vue 等）一律手动 import 引用，不进 easycom。
	// ⚠️ 改这里不会触发重编译，改完要顺手改动一个页面文件。
	"easycom": {
		"autoscan": true,
		"custom": {
			"^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue",
			"^Sg(.*)$": "@/components/$1/index.vue"
		}
	},
	"pages": [
		// pages 数组中第一项表示应用启动页
		{
			"path": "pages/index/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "一拍记",
				"enablePullDownRefresh": true,
				"backgroundTextStyle": "dark"
			}
		},
		// 开发验收页：7 个自研原子组件 + Feedback 宿主的双端截图用（D3 交付物）
		{
			"path": "pages/dev/components",
			"style": {
				"navigationBarTitleText": "组件验收"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "一拍记",
		// 下面两个色值必须与 design/tokens/tokens.json 的 color.bg.base (#FAFAFC) 保持一致。
		// 这是全工程**唯一**允许出现字面色值的地方：导航栏底色由平台读取，只接受字面量，
		// 无法引用 SCSS 变量或 CSS 自定义属性。改 token 时记得同步这里。
		"navigationBarBackgroundColor": "#FAFAFC",
		"backgroundColor": "#FAFAFC"
	}
}
